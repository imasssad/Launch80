# No real orders unless LIVE=true AND independent acknowledgment and wallet config.
LIVE=false
LIVE_ACK=
LIVE_BUY_ACK=
# Live entries require BUY_ENABLED=true plus LIVE_BUY_ACK; disabled by default.
BUY_ENABLED=false
ENABLE_ROBINHOOD=true
ENABLE_SOLANA=true
DB_PATH=./data/launch80.sqlite
# A pool must be at least $5K in a feed, but that does not make it safe.
MIN_LIQUIDITY_USD=5000
BUY_USD=5
MAX_LIQUIDITY_FRACTION=0.001
MAX_OPEN_POSITIONS=2
MAX_TOTAL_EXPOSURE_USD=20
MAX_DAILY_REALIZED_LOSS_USD=20
MAX_PRICE_IMPACT_BPS=150
MAX_ROUNDTRIP_COST_BPS=600
SLIPPAGE_BPS=100
# 80s is the first exit evaluation, not a forced sell.
# Keep loss-making tokens OPEN; require conservative net-of-swap proceeds >= basis + floor.
HOLD_SECONDS=80
MIN_EXIT_PROFIT_BPS=100
EXIT_COST_BUFFER_BPS=50
# Flat USD added to the exit floor for network costs that do NOT scale with
# trade size (tx fees, priority fees, unrecovered ATA rent). Measure your real
# roundtrip cost and set it yourself; this default is an estimate, not an oracle.
EXIT_GAS_RESERVE_USD=0.10
PROFIT_RECHECK_SECONDS=12
# No forced loss liquidation. Alert after 15 minutes, pause new buys if >=35% quoted loss.
UNDERWATER_ALERT_SECONDS=900
UNDERWATER_PAUSE_BPS=3500
MIN_POOL_AGE_SECONDS=12
MAX_POOL_AGE_SECONDS=150
POLL_SECONDS=30
# Seconds between entry evaluations. Each one costs several price-feed
# requests, so this is the main lever on API quota. On a free-tier feed
# (GeckoTerminal ~30 req/min) use 6 or higher; a fast tick exhausts the
# quota and starves the exit quotes that actually matter.
ENTRY_INTERVAL_SECONDS=2
PAGE_COUNT=2
MAX_BUY_ATTEMPTS_PER_HOUR=10
MAX_CONSECUTIVE_FEED_FAILURES=5
MAX_EXIT_RETRY_SECONDS=45
HTTP_HOST=127.0.0.1
HTTP_PORT=8088
# Optional bearer token for /pause and /resume from scripts, min 24 chars.
CONTROL_TOKEN=
# ---- Operator dashboard authentication -------------------------------------
# LEAVE ADMIN_PASSWORD BLANK unless the monitor is reachable from a network.
# Blank = no session auth, and the monitor MUST then stay bound to 127.0.0.1:
# /positions and /events expose open positions and their sell timers.
# Set it (>=14 chars) plus SESSION_SECRET (>=32 chars) to require sign-in on
# every route, enabling the dashboard to be served through a reverse proxy.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # SESSION_SECRET
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional TOTP second factor (base32). Requires ADMIN_PASSWORD.
#   python3 -c "import pyotp; print(pyotp.random_base32())"
TOTP_SECRET=
# Comma-separated IPs/CIDRs that the global login throttle never locks out, so
# a credential-stuffing flood from elsewhere cannot lock you out of your own bot.
OWNER_IP_ALLOWLIST=
# Set false ONLY for local plaintext testing; true requires HTTPS cookies.
COOKIE_SECURE=true
# LIVE ONLY: dedicated professional RPC providers and dedicated limited-balance hot wallets.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ZEROX_API_KEY=
JUPITER_API_KEY=
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY_B58=
# MUST obtain/verify spender & transaction target addresses from official 0x quote/docs.
# Never approve arbitrary addresses; NEVER approve the 0x Settler.
# Both are required when LIVE=true and ENABLE_ROBINHOOD=true.
ZEROX_APPROVED_SPENDERS=
ZEROX_APPROVED_TX_TARGETS=
# Solana mainnet-beta genesis hash, used to refuse a wrong-cluster RPC.
# Leave blank to use the built-in default. If you set it, use the FULL 44-char
# hash from `solana genesis-hash --url mainnet-beta` -- NOT the 32-char CAIP-2
# chain id prefix, which can never match and would block every live Solana trade.
SOLANA_EXPECTED_GENESIS_HASH=
REQUIRE_ROBINHOOD_SIMULATION=true
# Garp is optional token metadata; its public API is not an execution venue.
GARP_ENRICH=true
# When true, ONLY pons-v1/pons-v2 on Robinhood, pumpfun on Solana are admitted.
GARP_REQUIRE_LAUNCHPAD=false
MAX_EXIT_ATTEMPTS=8
